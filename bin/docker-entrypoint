#!/usr/bin/env bash
set -euo pipefail

bundle check || bundle install

# Custom db prepare that removes transaction_timeout
bundle exec hanami db prepare || true

# Remove transaction_timeout from structure.sql for PostgreSQL 16 compatibility
if [ -f config/db/structure.sql ]; then
  echo "Removing transaction_timeout from structure.sql..."
  sed -i '/SET transaction_timeout = 0;/d' config/db/structure.sql
  echo "Done. Retrying db prepare..."
  bundle exec hanami db prepare
fi

exec "$@"
